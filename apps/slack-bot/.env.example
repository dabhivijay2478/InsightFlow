# Slack credentials (from api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...         # Socket Mode app token
SLACK_SIGNING_SECRET=...

# The Mantrixflow Next.js app URL (must be publicly accessible for agent API calls)
AGENT_API_BASE_URL=https://your-app.mantrixflow.com

# Optional: pre-set a default agent key so users don't need to specify one
SLACK_DEFAULT_AGENT_KEY=

PORT=3010
