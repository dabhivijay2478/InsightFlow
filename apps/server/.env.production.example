# ============================================================================
# MantrixFlow — Production Environment Variables
# Copy to .env.production and fill in real values
# ============================================================================

# ── Supabase (Database & Auth) ─────────────────────────────
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# ── Encryption (MUST be identical for Go API and ETL) ──────
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_MASTER_KEY=your-fernet-key-here
ENCRYPTION_KEY=your-fernet-key-here

# ── Inter-service Auth Tokens ──────────────────────────────
# Generate: openssl rand -hex 32
ETL_INTERNAL_TOKEN=generate-a-random-64-char-hex-string
CALLBACK_TOKEN=generate-a-random-64-char-hex-string
INTERNAL_TOKEN=generate-a-random-64-char-hex-string

# ── Public URLs ────────────────────────────────────────────
API_PUBLIC_URL=https://api.yourdomain.com

# ── CORS ───────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com

# ── ETL Config ─────────────────────────────────────────────
MAX_CONCURRENT_RUNS=2
MAX_TAPS_PER_SOURCE=2
DEFAULT_SYNC_TIMEOUT_SECONDS=300
LOG_LEVEL=INFO

# ── Pipeline Execution Limits (MVP) ───────────────────────
PIPELINE_MAX_CONCURRENT=2
PIPELINE_MAX_PER_HOUR=3
PIPELINE_MAX_PER_DAY=20
PIPELINE_MAX_PER_ORG_CONCURRENT=1
PIPELINE_MAX_PER_ORG_PER_HOUR=2

# ── API Port (external mapping) ───────────────────────────
API_PORT=5000
