# ============================================================================
# MantrixFlow — Production Environment Variables
# Copy to .env.production and fill in real values
# ============================================================================

# ── Supabase (Database & Auth) ─────────────────────────────
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# ── Encryption (MUST be identical for Go API and ETL) ──────
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_MASTER_KEY=your-fernet-key-here
ENCRYPTION_KEY=your-fernet-key-here

# ── Inter-service Auth Tokens ──────────────────────────────
# Generate: openssl rand -hex 32
ELT_INTERNAL_TOKEN=generate-a-random-64-char-hex-string
CALLBACK_TOKEN=generate-a-random-64-char-hex-string
INTERNAL_TOKEN=generate-a-random-64-char-hex-string

# ── Public URLs ────────────────────────────────────────────
# AWS ECS (see apps/mantrixflow-infra/DEPLOYMENT.md): API on ALB; ELT internal only.
API_PUBLIC_URL=https://cloud.api.mantrixflow.com
APP_WEB_URL=https://cloud.mantrixflow.com
PUBLIC_APP_URL=https://cloud.mantrixflow.com
# AWS CDK sets ELT_PYTHON_SERVICE_URL=http://elt-service:8000 (ECS Service Connect).
ELT_PYTHON_SERVICE_URL=http://elt-service:8000
# Optional local/dev override when Slack must call a tunnel but the browser UI
# should return to APP_WEB_URL. In production, leave this unset unless different.
# SLACK_OAUTH_REDIRECT_BASE_URL=https://your-ngrok-host.ngrok-free.app

# ── Slack App ──────────────────────────────────────────────
SLACK_CLIENT_ID=123456789.123456789
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_OAUTH_REDIRECT_BASE_URL=https://cloud.mantrixflow.com
# Optional for tests/proxies; defaults to https://slack.com/api
SLACK_API_BASE_URL=https://slack.com/api

# ── GitHub App ─────────────────────────────────────────────
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=your-github-app-slug
# PEM can be supplied as base64 or with literal \n line breaks
GITHUB_APP_PRIVATE_KEY=your-github-app-private-key
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
# Optional for tests/proxies; defaults to https://api.github.com
GITHUB_API_BASE_URL=https://api.github.com

# ── Email ──────────────────────────────────────────────────
EMAIL_PROVIDER=ses
EMAIL_FROM="MantrixFlow <support@mantrixflow.com>"
EMAIL_LOGO_URL=https://cloud.mantrixflow.com/m.png
AWS_SES_REGION=ap-south-1
AWS_SES_CONFIGURATION_SET=mantrixflow-transactional
AWS_SES_EVENT_SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:mantrixflow-ses-events

# ── Billing ────────────────────────────────────────────────
DODO_PAYMENTS_API_KEY=your-dodo-api-key
DODO_WEBHOOK_SECRET=your-dodo-webhook-secret
DODO_PRODUCT_GROWTH_MONTHLY=your-product-id
DODO_PRODUCT_GROWTH_ANNUAL=your-product-id
DODO_PRODUCT_PRO_MONTHLY=your-product-id
DODO_PRODUCT_PRO_ANNUAL=your-product-id
DODO_PRODUCT_ENTERPRISE=
DODO_PRODUCT_COLLECTION_ID=your-collection-id
DODO_ROWS_DELIVERED_EVENT_NAME=rows_delivered
DODO_ROWS_DELIVERED_METER_ID=your-meter-id
DODO_API_CALLS_USAGE_BILLING_ENABLED=false
DODO_API_CALLS_EVENT_NAME=api_call
DODO_API_CALLS_METER_ID=

# ── CORS ───────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://cloud.mantrixflow.com

# ── ETL Config ─────────────────────────────────────────────
MAX_CONCURRENT_RUNS=2
MAX_TAPS_PER_SOURCE=2
STAGING_ROOT=/tmp/mxf-duckdb
STAGING_DISK_LIMIT_GB=50
DEFAULT_SYNC_TIMEOUT_SECONDS=300
LOG_LEVEL=INFO
ENVIRONMENT=production

# ── Pipeline Execution Limits (MVP) ───────────────────────
PIPELINE_MAX_CONCURRENT=2
PIPELINE_MAX_PER_HOUR=3
PIPELINE_MAX_PER_DAY=20
PIPELINE_MAX_PER_ORG_CONCURRENT=1
PIPELINE_MAX_PER_ORG_PER_HOUR=2
PIPELINE_MAX_PER_SOURCE_CONCURRENT=1
PGMQ_PARALLEL_WORKERS=2
ELT_STAGING_DISPATCH_HEADROOM_MULTIPLIER=2
ORG_INVITE_MODE=supabase_link
BILLING_GRACE_PERIOD_DAYS=7

# ── API Port (ECS container listens on 8080) ───────────────
PORT=8080

# ── PostHog (product analytics, error tracking, session replay) ────────────
# Get from https://us.posthog.com/settings/project
POSTHOG_API_KEY=phc_your-project-api-key
POSTHOG_HOST=https://us.i.posthog.com

# ── Better Stack (status.mantrixflow.com) — store in AWS SSM on production ───
# Setup: md-docs/betterstack-setup.md + md-docs/observability-deployment.md (AWS SSM).
BETTERSTACK_API_TOKEN=your-betterstack-api-token
BETTERSTACK_STATUS_PAGE_ID=your-status-page-id
BETTERSTACK_RESOURCE_APP=status-page-resource-id-for-app
BETTERSTACK_RESOURCE_API=status-page-resource-id-for-main-server
BETTERSTACK_RESOURCE_ELT=status-page-resource-id-for-etl-server

# ── Pasted local/dev names intentionally not used in production ─────────────
# ETL_PYTHON_SERVICE_URL=http://127.0.0.1:8000
# ETL_INTERNAL_TOKEN=...
# NEXT_PUBLIC_API_URL=http://localhost:5000
# SLACK_PROXY_TARGET_URL=http://localhost:5000
# ALLOW_SOURCE_DB_MUTATIONS_FOR_CDC=false
# ALLOW_SOURCE_DB_MUTATIONS=true
# DODO_SKIP_WEBHOOK_VERIFY=true
# EMAIL_SIMULATE_DELIVERY_DOMAINS=...
