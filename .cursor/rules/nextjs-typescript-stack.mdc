### Naming Conventions
- Components: `PascalCase` — `SourcePanel.tsx`, `RunStatusDrawer.tsx`
- Hooks: `use*` — `useSourceSchemas.ts`, `useDiscoverTable.ts`
- Types/Interfaces: `PascalCase` — `SourceStreamConfig`, `RunResult`
- Constants: `UPPER_SNAKE_CASE` or `camelCase` — `MAX_ROWS = 1000`, `defaultTimeout`
- Variables: `camelCase` — `selectedStreams`, `isLoading`
- CSS classes: `kebab-case` — `pipeline-canvas`, `source-panel`
- Event handlers: `handle*` — `handleClick`, `handleInputChange`
- Boolean variables: `is*` / `has*` — `isLoading`, `hasErrors`

### Type Safety Pattern
```typescript
// ✓ CORRECT: Define strict interfaces
interface SourceStreamConfig {
  stream_key: string;  // "schema.table"
  replication_method: "FULL_TABLE" | "INCREMENTAL";
  replication_key?: string;
  duckdb_table_name: string;  // "schema__table"
}

interface DiscoverTableResponse {
  exists: boolean;
  schema: string;
  table: string;
  columns: {
    name: string;
    type: string;
    nullable: boolean;
    primary_key: boolean;
  }[];
  primary_keys: string[];
}

// ✓ Use types strictly
const config: SourceStreamConfig = {
  stream_key: "public.users",
  replication_method: "INCREMENTAL",
  replication_key: "updated_at",
  duckdb_table_name: "public__users",
};

// ✗ WRONG: Using any
const config: any = { stream_key: "public.users" };  // No type checking

// ✗ WRONG: Implicit any
const config = { stream_key: "public.users" };  // TypeScript infers any
```

### React Hook Pattern
```typescript
// ✓ CORRECT: Use React Query with proper error handling
import { useMutation, useQuery } from "@tanstack/react-query";
import { toast } from "@/lib/utils/toast";

export function SourcePanel() {
  const { data: tables, isLoading, error } = useQuery({
    queryKey: ["source-tables", dataSourceId],
    queryFn: async () => {
      const response = await fetch(`/api/v1/sources/${dataSourceId}/discover`);
      if (!response.ok) {
        throw new Error(await response.text());
      }
      return response.json();
    },
    staleTime: 5 * 60 * 1000,  // 5 minutes
    retry: 2,
  });

  const discoverMutation = useMutation({
    mutationFn: async (table: string) => {
      const response = await fetch(`/api/v1/discover-table`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ table }),
      });
      if (!response.ok) throw new Error(await response.text());
      return response.json();
    },
    onSuccess: (data) => {
      toast.success("Discovered table", `Found ${data.columns.length} columns`);
    },
    onError: (error) => {
      toast.error("Discovery failed", error instanceof Error ? error.message : "Unknown error");
    },
  });

  if (error) return <div>Error: {error.message}</div>;
  if (isLoading) return <div>Loading...</div>;

  return (
    <div>
      {/* UI here */}
    </div>
  );
}

// ✗ WRONG: Using fetch directly without error handling
export function BadComponent() {
  const [data, setData] = useState(null);
  useEffect(() => {
    fetch(`/api/sources/${id}`).then(r => r.json()).then(setData);
  }, []);  // ← No cleanup, no error handling
  return <div>{data?.name}</div>;
}
```

### Component Best Practices
```typescript
// ✓ CORRECT: Memoized callback, proper dependencies
interface MyComponentProps {
  onSelect: (id: string) => void;
  data: string[];
}

export function MyComponent({ onSelect, data }: MyComponentProps) {
  const [selected, setSelected] = useState<string | null>(null);
  
  const handleSelect = useCallback((id: string) => {
    setSelected(id);
    onSelect(id);
  }, [onSelect]);  // ← Dependency array includes onSelect
  
  return (
    <ul>
      {data.map((item) => (
        <li key={item} onClick={() => handleSelect(item)}>
          {item}
        </li>
      ))}
    </ul>
  );
}

// ✗ WRONG: Inline handler, missing dependency
export function BadComponent({ onSelect, data }) {
  return (
    <ul>
      {data.map((item) => (
        <li onClick={() => onSelect(item)}>{item}</li>  // ← No memoization, no deps
      ))}
    </ul>
  );
}
```

### API Response Handling
```typescript
// ✓ CORRECT: Type your API responses
interface ApiResponse<T> {
  status: "success" | "error";
  data: T | null;
  message: string;
  error_code?: string;
}

// ✓ Create service class
export class PipelineService {
  async getPipeline(id: string): Promise<PipelineConfig> {
    const response = await fetch(`/api/v1/pipelines/${id}`, {
      headers: { "Authorization": `Bearer ${getToken()}` },
    });
    
    if (!response.ok) {
      const error = await response.json();
      throw new Error(error.message || "Failed to fetch pipeline");
    }
    
    const result: ApiResponse<PipelineConfig> = await response.json();
    if (result.status !== "success") {
      throw new Error(result.message);
    }
    
    return result.data!;
  }
}

// ✓ Use in hook
export function usePipeline(id: string) {
  return useQuery({
    queryKey: ["pipeline", id],
    queryFn: () => PipelineService.getPipeline(id),
  });
}

// ✗ WRONG: No type checking
const [data, setData] = useState(null);
useEffect(() => {
  fetch(`/api/pipelines/${id}`)
    .then(r => r.json())
    .then(setData);  // ← data could be any shape, no error handling
}, [id]);
```

